{
  "name": "@ruchoir/i18n",
  "version": "0.3.0",
  "description": "How every Ruchoir interface speaks six languages: the languages, formatting in the language in force, the products' names, the shared sentences and the check that keeps the dictionaries honest.",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dictionaries/*.json": "./dictionaries/*.json"
  },
  "bin": {
    "ruchoir-i18n-check": "./bin/i18n-check.mjs"
  },
  "files": [
    "src",
    "dictionaries",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "i18n:check": "node bin/i18n-check.mjs"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruchoir/core",
    "directory": "packages/i18n"
  }
}
